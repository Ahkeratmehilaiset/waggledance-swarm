      "required_for": [{"feature": "bridge_core", "lanes": ["lead", "tools", "fable"], "platforms": ["windows"]}],
      "min_version": "2.0.0", "timeout_seconds": 3,
      "install": {"source_url": "https://git-scm.com/downloads", "package_id": "Git.Git"}
    },
    {
      "id": "windows_powershell", "kind": "cli", "probe": "powershell",
