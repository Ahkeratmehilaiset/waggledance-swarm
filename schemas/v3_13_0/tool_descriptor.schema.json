{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://waggledance.local/schemas/v3_13_0/tool_descriptor.schema.json",
  "title": "v3.13.0 ToolDescriptor",
  "description": "Secret-free manifest for a runnable tool, solver, doctor, sync, projector, or repair step.",
  "type": "object",
  "required": [
    "schema_version",
    "tool_id",
    "profile",
    "domain",
    "phase",
    "read_scopes",
    "write_scopes",
    "credential_refs",
    "connector_refs",
    "state_refs",
    "checkpoint_refs",
    "rate_limits",
    "idempotency_key",
    "dry_run_supported",
    "shadow_supported",
    "rollback_artifact",
    "owner_agent",
    "promotion_gate_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "domain": {
      "type": "string",
      "pattern": "^DOM-(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "discover",
        "ingest",
        "sync",
        "normalize",
        "persist",
        "index",
        "project",
        "status",
        "doctor",
        "repair",
        "report",
        "write",
        "synthesize",
        "observe"
      ]
    },
    "read_scopes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/scope_ref"
      },
      "uniqueItems": true
    },
    "write_scopes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/scope_ref"
      },
      "uniqueItems": true
    },
    "credential_refs": {
      "description": "Credential references only. Secret material is never embedded in the descriptor.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/credential_ref"
      },
      "uniqueItems": true
    },
    "connector_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ref_id"
      },
      "uniqueItems": true
    },
    "state_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ref_id"
      },
      "uniqueItems": true
    },
    "checkpoint_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ref_id"
      },
      "uniqueItems": true
    },
    "rate_limits": {
      "type": "object",
      "required": ["max_workers", "request_delay_s"],
      "additionalProperties": false,
      "properties": {
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "request_delay_s": {
          "type": "number",
          "minimum": 0
        },
        "burst": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "dry_run_supported": {
      "type": "boolean"
    },
    "shadow_supported": {
      "type": "boolean"
    },
    "rollback_artifact": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "owner_agent": {
      "type": "string",
      "enum": ["codex", "claude", "shared", "operator"]
    },
    "promotion_gate_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ref_id"
      },
      "uniqueItems": true
    },
    "write_risk_class": {
      "type": "string",
      "enum": ["informational", "internal_memory", "local_artifact", "external_effect"]
    },
    "capture_supported": {
      "type": "boolean",
      "description": "Whether BehaviorCapture may wrap this tool. Per-invocation consent is still required for live sensitive captures."
    },
    "capture_policy_ref": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "definitions": {
    "ref_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "scope_ref": {
      "type": "string",
      "pattern": "^(state|repo|artifact|magma|bridge|external):[A-Za-z0-9_./:-]{1,180}$"
    },
    "credential_ref": {
      "type": "string",
      "pattern": "^vault://[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9_.-]+/[a-z0-9_.-]+$"
    }
  }
}
