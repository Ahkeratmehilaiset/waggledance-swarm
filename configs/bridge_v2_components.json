      "min_version": "0.1.0", "timeout_seconds": 3,
      "resolution": {"kind": "npm_native", "package": "@openai/codex", "bin": "bin/codex.js", "native_relpaths": ["node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe", "vendor/x86_64-pc-windows-msvc/bin/codex.exe"], "trusted_sha256": null},
      "install": {"source_url": "https://developers.openai.com/codex/cli", "package_id": "@openai/codex"}
