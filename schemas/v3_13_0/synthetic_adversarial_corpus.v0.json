{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://waggledance.local/schemas/v3_13_0/synthetic_adversarial_corpus.v0.json",
  "title": "MAGMA Synthetic Adversarial Corpus v0",
  "description": "Top-level synthetic adversarial corpus envelope. Individual cases and hidden expectations are validated by their paired schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "cases"
  ],
  "properties": {
    "corpus_version": {
      "const": "magma.synthetic_adversarial_corpus.v0"
    },
    "generated_at_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 32
    },
    "expansion_label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,80}$"
    },
    "expansion_status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,80}$"
    },
    "expansion_note": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_version",
        "held_out_case_ids"
      ],
      "properties": {
        "split_version": {
          "const": "magma.synthetic_adversarial_split.v0"
        },
        "held_out_case_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^case:adv:[a-z0-9_]{4,48}:[0-9]{3}$"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
