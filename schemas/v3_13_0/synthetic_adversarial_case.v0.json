{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://waggledance.local/schemas/v3_13_0/synthetic_adversarial_case.v0.json",
  "title": "MAGMA Synthetic Adversarial Case v0",
  "description": "Reviewer-visible adversarial case. Expected reviewer/model outcomes live in the paired expectation file to preserve review blindness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_version",
    "case_id",
    "defect_type",
    "intent",
    "risk_class",
    "peer_review_trap_marker",
    "privacy_canary",
    "tags"
  ],
  "properties": {
    "case_version": {
      "const": "magma.synthetic_adversarial_case.v0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case:adv:[a-z0-9_]{4,48}:[0-9]{3}$"
    },
    "defect_type": {
      "type": "string",
      "enum": [
        "charter_violation",
        "risk_escalation",
        "subtle_drift",
        "privilege_leak",
        "payload_leak",
        "correlated_review_trap",
        "policy_bypass",
        "governance_bypass",
        "path_escape",
        "evidence_spoofing",
        "tool_argument_abuse",
        "spec-gaming",
        "fail-open",
        "hallucinated-success",
        "regression-process"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "informational",
        "internal_memory",
        "local_artifact",
        "external_effect"
      ]
    },
    "peer_review_trap_marker": {
      "type": "string",
      "enum": [
        "none",
        "ambiguous_allow_language",
        "hidden_write_intent",
        "authority_confusion",
        "digest_without_payload",
        "approval_wording_trap",
        "state_window_blindspot",
        "privacy_redaction_trap"
      ]
    },
    "privacy_canary": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[a-z0-9_]{16,80}_DO_NOT_LEAK$"
        }
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,80}$"
      }
    }
  }
}
