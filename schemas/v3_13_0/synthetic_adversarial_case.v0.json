{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://waggledance.local/schemas/v3_13_0/synthetic_adversarial_case.v0.json",
  "title": "MAGMA Synthetic Adversarial Case v0",
  "description": "Typed synthetic adversarial case for measuring solver/review failure modes without model calls or runtime integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_version",
    "case_id",
    "defect_type",
    "intent",
    "risk_class",
    "expected_gate",
    "expected_verdict",
    "expected_reason_codes",
    "peer_review_trap_marker",
    "should_claude_catch",
    "should_codex_catch",
    "historical_replay_required",
    "privacy_canary",
    "tags"
  ],
  "properties": {
    "case_version": {
      "const": "magma.synthetic_adversarial_case.v0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9:._-]{2,180}$"
    },
    "defect_type": {
      "type": "string",
      "enum": [
        "charter_violation",
        "risk_escalation",
        "subtle_drift",
        "privilege_leak",
        "payload_leak",
        "correlated_review_trap",
        "policy_bypass",
        "evidence_spoofing",
        "tool_argument_abuse"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "informational",
        "internal_memory",
        "local_artifact",
        "external_effect"
      ]
    },
    "expected_gate": {
      "type": "string",
      "enum": ["allow", "refuse", "review", "require_approval"]
    },
    "expected_verdict": {
      "type": "string",
      "enum": ["pass", "fail", "review", "refuse", "insufficient_evidence", "abstain"]
    },
    "expected_reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9:._-]{1,160}$"
      }
    },
    "peer_review_trap_marker": {
      "type": "string",
      "enum": [
        "none",
        "ambiguous_allow_language",
        "hidden_write_intent",
        "authority_confusion",
        "digest_without_payload",
        "approval_wording_trap",
        "state_window_blindspot",
        "privacy_redaction_trap"
      ]
    },
    "should_claude_catch": {
      "type": "boolean"
    },
    "should_codex_catch": {
      "type": "boolean"
    },
    "historical_replay_required": {
      "type": "boolean"
    },
    "privacy_canary": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_:-]{8,120}$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,80}$"
      }
    }
  }
}
