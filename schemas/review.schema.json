{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://waggledance.local/schemas/review.schema.json",
  "title": "WaggleDance Phase 2A-2 review output",
  "description": "Schema for orchestrator/Invoke-WaggleReview.ps1 output. The reviewer emits this object inside a fenced ```review-json``` block. Phase 2B-Revision (SEC-009) adds OPTIONAL reviewer_self_id and suggested_next_actions[] fields so internal reviews slot into the GPT synthesis bundle alongside external reviewer outputs. Old reviews without the new fields still validate successfully.",
  "type": "object",
  "required": [
    "role",
    "target_iteration_id",
    "source_package_path",
    "summary",
    "verdict",
    "findings",
    "metrics",
    "completed"
  ],
  "additionalProperties": false,
  "properties": {
    "reviewer_self_id": {
      "type": "object",
      "description": "Phase 2B-Revision (SEC-009) optional self-introduction. When present, must include claimed_model_name, the two self-assessment arrays, and uses_extended_thinking_or_reasoning_mode.",
      "required": [
        "claimed_model_name",
        "self_assessed_strengths_for_this_review",
        "self_assessed_limitations_for_this_review",
        "uses_extended_thinking_or_reasoning_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "claimed_model_name": { "type": "string", "minLength": 1 },
        "claimed_version": { "type": ["string", "null"] },
        "training_cutoff": { "type": ["string", "null"] },
        "self_assessed_strengths_for_this_review": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "self_assessed_limitations_for_this_review": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "estimated_context_window_kb": { "type": ["integer", "null"] },
        "uses_extended_thinking_or_reasoning_mode": { "type": "boolean" },
        "runtime": {
          "type": "string",
          "description": "Always 'claude_code' for internal Phase 2A-2 reviews.",
          "enum": ["claude_code"]
        }
      }
    },
    "suggested_next_actions": {
      "type": "array",
      "description": "Phase 2B-Revision (SEC-009) optional improvement proposals. Each item is the same shape as Phase 2B external_review.suggested_next_actions[].",
      "items": {
        "type": "object",
        "required": ["id", "title", "rationale", "approach", "estimated_effort", "risks", "expected_payoff"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "approach": { "type": "string", "minLength": 1 },
          "estimated_effort": { "type": "string", "enum": ["small", "medium", "large"] },
          "risks": { "type": "string", "minLength": 1 },
          "expected_payoff": { "type": "string", "minLength": 1 }
        }
      }
    },
    "role": {
      "type": "string",
      "enum": ["architect", "security", "reliability"]
    },
    "target_iteration_id": {
      "type": "string",
      "minLength": 1
    },
    "source_package_path": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "pass_with_notes", "needs_attention", "fail"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "title",
          "where",
          "evidence",
          "why_it_matters",
          "recommended_action"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "title": { "type": "string", "minLength": 1 },
          "where": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "recommended_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "files_reviewed",
        "lines_reviewed",
        "review_duration_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "files_reviewed": { "type": "integer", "minimum": 0 },
        "lines_reviewed": { "type": "integer", "minimum": 0 },
        "review_duration_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "completed": {
      "type": "boolean"
    }
  }
}
