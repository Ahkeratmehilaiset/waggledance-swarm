dashboard/dist

# Tests & tools (not needed in production image)
tests/
tools/
docs/
# Phase 16F + 17A carve-outs: include canonical proof scripts + autonomy_growth
# smoke tests so the same image can run `python tools/run_*_proof.py` and the
# targeted pytest smoke suite under `--network none` for the v3.8.0 stable gate
# and the v3.9.0-producer-fabric-alpha producer fabric + 10k scale proofs.
!tools/run_full_restart_continuity_proof.py
!tools/run_upstream_structured_request_proof.py
!tools/run_automatic_runtime_hint_proof.py
!tools/run_phase16b_proof_soak.py
!tools/run_phase17a_producer_fabric_proof.py
!tools/run_solver_scale_proof.py
!tools/run_phase17b_local_efficiency_benchmark.py
!tools/run_phase17c_local_ollama_baseline.py
!tools/run_phase17d_local_model_sweep.py
# Phase 18A carve-outs: exporter + stdlib-only validator + JSON Schemas +
# benchmark tests + the three Phase 17B/17C/17D source JSONs that the
# exporter ingests. Markdown siblings remain excluded.
!tools/run_phase18a_benchmark_externalization.py
!tools/validate_phase18a_benchmark_bundle.py
!schemas/
!tests/benchmarks/
!docs/runs/phase17b_local_efficiency_benchmark_2026_05_04/phase17b_local_efficiency_benchmark.json
!docs/runs/phase17c_local_ollama_baseline_2026_05_04/phase17c_local_ollama_baseline.json
!docs/runs/phase17d_local_model_sweep_2026_05_05/phase17d_local_model_sweep.json
# Phase 18B carve-outs: gap miner proof harness + the canonical Phase 18A
# evidence bundle so the in-container validator can verify it.
!tools/run_phase18b_gap_miner_feedback_proof.py
!docs/runs/phase18a_benchmark_externalization_2026_05_05/export_bundle/
!docs/runs/phase18a_benchmark_externalization_2026_05_05/export_bundle/**
!tests/__init__.py
!tests/conftest.py
!tests/autonomy_growth/

