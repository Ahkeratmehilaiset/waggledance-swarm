{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://waggledance.local/schemas/v3_13_0/authenticated_connector.schema.json",
  "title": "v3.13.0 AuthenticatedConnector",
  "description": "Secret-free connector capability declaration. Credential material is resolved lazily by CredentialVault at use time.",
  "type": "object",
  "required": [
    "schema_version",
    "connector_id",
    "profile",
    "domain",
    "auth_mode",
    "credential_ref",
    "mfa_policy_ref",
    "secret_material_never_logged",
    "can_run_headless",
    "requires_operator_presence",
    "session_renewal_strategy",
    "revocation_procedure",
    "write_risk",
    "rate_limit",
    "state_refs",
    "supported_scopes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "connector_id": {
      "$ref": "#/definitions/ref_id"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "domain": {
      "type": "string",
      "pattern": "^DOM-(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "auth_mode": {
      "type": "string",
      "enum": [
        "no_auth",
        "env_key",
        "local_secret_file",
        "browser_profile",
        "interactive_mfa",
        "oauth_token",
        "session_cookie",
        "api_key",
        "operator_prompt"
      ]
    },
    "credential_ref": {
      "type": ["string", "null"],
      "pattern": "^vault://[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9_.-]+/[a-z0-9_.-]+$"
    },
    "mfa_policy_ref": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "secret_material_never_logged": {
      "const": true
    },
    "can_run_headless": {
      "type": "boolean"
    },
    "requires_operator_presence": {
      "type": "boolean"
    },
    "session_renewal_strategy": {
      "type": "string",
      "enum": ["none", "lazy_refresh", "scheduled_refresh", "operator_reauth", "fail_closed"]
    },
    "revocation_procedure": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "write_risk": {
      "type": "string",
      "enum": ["informational", "local_artifact", "external_effect"]
    },
    "rate_limit": {
      "type": "object",
      "required": ["max_workers", "request_delay_s"],
      "additionalProperties": false,
      "properties": {
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "request_delay_s": {
          "type": "number",
          "minimum": 0
        },
        "burst": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "state_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ref_id"
      },
      "uniqueItems": true
    },
    "supported_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read", "write", "shadow", "dry_run", "screenshot", "download", "upload"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "definitions": {
    "ref_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    }
  }
}
