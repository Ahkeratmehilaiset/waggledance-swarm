{
  "schema_version": "wd.magma.semantic_eval.v1",
  "source_contract": "magma.faiss.solver_projection.v1",
  "target_text_field": "embedding_text",
  "normalization": {
    "unicode": "NFKD; remove combining marks; casefold",
    "token_regex": "[a-z0-9]+",
    "drop_single_character_tokens": true,
    "drop_numeric_tokens": true,
    "stemming": false,
    "stopwords": [
      "a", "an", "and", "are", "as", "at", "be", "because", "before",
      "based", "by", "can", "considering", "could", "do", "does", "for",
      "from", "given", "has", "have", "her", "how", "i", "in", "into",
      "is", "it", "its", "may", "might", "must", "my", "of", "on",
      "onto", "or", "our", "per", "please", "should", "so", "the",
      "their", "this", "to", "under", "using", "what", "when", "whether",
      "which", "while", "will", "with", "without"
    ],
    "projection_boilerplate": [
      "solver", "name", "description", "variables", "outputs", "formulas",
      "capabilities", "tags", "calculate", "estimate", "predict",
      "determine", "check", "expected"
    ],
    "unit_tokens": [
      "binary", "bool", "boolean", "c", "count", "d", "day", "days",
      "db", "dbi", "dbm", "eur", "g", "gdd", "h", "hour", "hours",
      "kg", "kwh", "l", "m", "ma", "mah", "mhz", "min", "ml",
      "month", "months", "multiplier", "percent", "ppm", "ppb",
      "probability", "ratio", "score", "trips", "w", "week", "weeks",
      "year", "years"
    ]
  },
  "policies": {
    "query_writer_must_not_see": [
      "canonical_solver_id",
      "model_name",
      "retrieval_rankings"
    ],
    "retriever_must_not_receive": [
      "expected_solver",
      "expected_cell",
      "stratum"
    ],
    "forbidden_query_label_match": "No normalized canonical_solver_id or full model_name token sequence may occur contiguously in a query.",
    "semantic_zero_overlap_gate": "content_tokens(query) intersect content_tokens(target embedding_text) must be empty."
  },
  "cases": [
    {
      "query_id": "A01",
      "stratum": "anchored_natural",
