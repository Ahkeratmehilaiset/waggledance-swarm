{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://waggledance.local/schemas/hex_cell_genome.v1.json",
  "title": "HexCellGenomeV1",
  "description": "Content-addressed, shadow-first reconstruction contract for one WaggleDance hex cell.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "canonicalization",
    "cell_id",
    "mesh_id",
    "mesh_kind",
    "topology_epoch",
    "axial_coord",
    "parent_cell_id",
    "child_cell_ids",
    "neighbor_cell_ids",
    "repair_peer_cell_ids",
    "capabilities",
    "durable_inputs",
    "expected_cell_state_root",
    "restore_state",
    "runtime_activation_authority_granted",
    "genome_digest"
  ],
  "properties": {
    "contract_version": {
      "const": "hex_cell_genome.v1"
    },
    "canonicalization": {
      "const": "magma-jcs-subset-v1"
    },
    "cell_id": {
      "$ref": "#/definitions/id_token"
    },
    "mesh_id": {
      "$ref": "#/definitions/id_token"
    },
    "mesh_kind": {
      "$ref": "#/definitions/mesh_kind"
    },
    "topology_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "axial_coord": {
      "anyOf": [
        {
          "$ref": "#/definitions/axial_coord"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_cell_id": {
      "anyOf": [
        {
          "$ref": "#/definitions/id_token"
        },
        {
          "type": "null"
        }
      ]
    },
    "child_cell_ids": {
      "$ref": "#/definitions/cell_id_array"
    },
    "neighbor_cell_ids": {
      "$ref": "#/definitions/cell_id_array"
    },
    "repair_peer_cell_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id_token"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/capability"
      }
    },
    "durable_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/durable_input"
      }
    },
    "expected_cell_state_root": {
      "$ref": "#/definitions/sha256_digest"
    },
    "restore_state": {
      "const": "shadow_only"
    },
    "runtime_activation_authority_granted": {
      "const": false
    },
    "genome_digest": {
      "$ref": "#/definitions/sha256_digest"
    }
  },
  "definitions": {
    "id_token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safe_posix_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "mesh_kind": {
      "type": "string",
      "enum": [
        "axial_agent_mesh",
        "logical_solver_overlay",
        "hierarchical_runtime_shadow"
      ]
    },
    "axial_coord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "r"
      ],
      "properties": {
        "q": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "r": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "cell_id_array": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id_token"
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability_id",
        "source_ref",
        "source_digest",
        "required"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "solver",
            "agent",
            "router"
          ]
        },
        "capability_id": {
          "$ref": "#/definitions/id_token"
        },
        "source_ref": {
          "$ref": "#/definitions/safe_posix_relative_path"
        },
        "source_digest": {
          "$ref": "#/definitions/sha256_digest"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "durable_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "kind",
        "source_ref",
        "source_digest",
        "rebuild_strategy",
        "replay_checkpoint",
        "required"
      ],
      "properties": {
        "input_id": {
          "$ref": "#/definitions/id_token"
        },
        "kind": {
          "type": "string",
          "enum": [
            "repo_artifact",
            "magma_ledger",
            "snapshot_manifest",
            "model_manifest",
            "external_export"
          ]
        },
        "source_ref": {
          "$ref": "#/definitions/safe_posix_relative_path"
        },
        "source_digest": {
          "$ref": "#/definitions/sha256_digest"
        },
        "rebuild_strategy": {
          "type": "string",
          "enum": [
            "git_checkout",
            "replay",
            "verified_copy",
            "external_reprovision"
          ]
        },
        "replay_checkpoint": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
