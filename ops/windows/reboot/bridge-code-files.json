{
  "schema": "wd.bridge-code-package.v1",
  "purpose": "Hash-pinned bridge communication code shipped inside the commit-addressed reboot bundle under tools-bootstrap. BridgeCodeContext.ps1 verifies it against the externally anchored deployment manifest before any lane or Tools CLI launch and exports only WD_BRIDGE_* discovery variables to the model shell. Python isolation (PYTHONPATH, PYTHONSAFEPATH, PYTHONNOUSERSITE, PYTHONDONTWRITEBYTECODE, -S -B) exists only inside Invoke-WdBridgePython.ps1 for one tool call and is restored afterwards, so task-worktree imports, tests and development stay untouched. Task worktrees stay the Git cwd, the bridge runtime root stays the data root; this package is code only and never a task repository.",
  "package_relative_root": "tools-bootstrap",
  "invocation_wrapper_relative": "Invoke-WdBridgePython.ps1",
  "python_files": [
    "configs/bridge_event_validation_waivers.json",
    "configs/bridge_identity_registry.json",
    "tools/__init__.py",
    "tools/agent_next_task.py",
    "tools/bridge_compact_view.py",
    "tools/bridge_next_action.py",
    "tools/build_bridge_message_template.py",
    "tools/validate_bridge_event.py",
    "tools/wd_grok_helper.py",
    "waggledance/__init__.py",
    "waggledance/core/__init__.py",
    "waggledance/core/bridge_event_schema.py",
    "waggledance/core/bridge_identity_registry.py",
    "waggledance/core/bridge_log_reader.py",
    "waggledance/core/idle_protocol_deferred_lift.py",
    "waggledance/core/work_queue.py"
  ],
  "python_entrypoints": {
    "next_action": "tools/bridge_next_action.py",
    "agent_next_task": "tools/agent_next_task.py",
    "compact_view": "tools/bridge_compact_view.py",
    "message_template": "tools/build_bridge_message_template.py",
    "validate_event": "tools/validate_bridge_event.py",
    "grok_helper": "tools/wd_grok_helper.py"
  },
  "python_platform": {
    "implementation": "cp",
    "python_version": "3.13",
    "abi": "cp313",
    "platform": "win_amd64"
  },
