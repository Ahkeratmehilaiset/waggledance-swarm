      "resolution": {"kind": "npm_native", "package": "@anthropic-ai/claude-code", "bin": "bin/claude.exe", "native_relpaths": ["bin/claude.exe"], "trusted_sha256": null},
      "install": {"source_url": "https://github.com/anthropics/claude-code", "package_id": "@anthropic-ai/claude-code"}
